{
  "name": "salad-soulmates",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "prelint": "next typegen",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare:ingredients": "node scripts/prepare-ingredient-load.mjs",
    "prepare:customer-data": "node scripts/prepare-customer-data-load.mjs",
    "format": "prettier --write \"**/*.{css,json,md,yml}\" && eslint . --fix",
    "format:check": "prettier --check \"**/*.{css,json,md,yml}\"",
    "test:browser": "playwright test",
    "test:postgres": "vitest run --config vitest.postgres.config.mts",
    "sample-data:reset": "supabase db reset --local --sql-paths ./seed.sql"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ag-grid-community/locale": "36.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-scheduler": "^9.0.0-beta.12",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "bwip-js": "4.11.4",
    "date-fns": "^4.1.0",
    "expo": "^57.0.25",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csv-parse": "7.0.2",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.2.0",
    "eslint-config-next": "16.3.5",
    "pg": "8.23.0",
    "prettier": "3.9.8",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
